{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ceibo",
  "colors": {
    "primary": "#E1685A",
    "light": "#ED9286",
    "dark": "#C54E40"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "travel-requirements"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Countries",
            "pages": [
              "api-reference/endpoint/list-countries",
              "api-reference/endpoint/get-country"
            ]
          },
          {
            "group": "Cities",
            "pages": [
              "api-reference/endpoint/list-cities",
              "api-reference/endpoint/search-cities"
            ]
          },
          {
            "group": "Entry requirements",
            "pages": [
              "api-reference/endpoint/list-entry-requirements",
              "api-reference/endpoint/personalized-entry-requirements",
              "api-reference/endpoint/entry-requirements-by-destination",
              "api-reference/endpoint/get-entry-requirement"
            ]
          },
          {
            "group": "Health requirements",
            "pages": [
              "api-reference/endpoint/list-health-requirements",
              "api-reference/endpoint/get-health-requirement"
            ]
          },
          {
            "group": "Vaccines",
            "pages": [
              "api-reference/endpoint/list-vaccines",
              "api-reference/endpoint/get-vaccine"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://api.ceibo.me/v1/health",
          "icon": "heart-pulse"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/ceibo-travel",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@ceibo.me"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Developer dashboard",
      "href": "https://developer.ceibo.me"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ceibo-travel"
    }
  }
}
